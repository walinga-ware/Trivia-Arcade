  "JUPITER_MOON_HINTS": {
    "Metis": "Orbits closer to Jupiter than any other known moon",
    "Adrastea": "The smallest of Jupiter's four inner moons, and the first natural satellite ever discovered in spacecraft images rather than through a telescope",
    "Amalthea": "The largest of Jupiter's four inner moons, a reddish potato-shaped body discovered in 1892",
    "Thebe": "An inner moon marked by an unusually large crater named Zethus",
    "Io": "The most volcanically active body known in the solar system",
    "Europa": "An icy moon believed to hide a vast liquid ocean beneath its crust",
    "Ganymede": "The largest moon in the solar system, bigger than the planet Mercury",
    "Callisto": "The most heavily cratered object known in the solar system",
    "Themisto": "An irregular moon orbiting alone between the inner moons and the Himalia group",
    "Leda": "The smallest member of the Himalia group of irregular moons, discovered in 1974",
    "Himalia": "The largest of Jupiter's irregular moons",
    "Lysithea": "The second-smallest member of the Himalia group of irregular moons, discovered in 1938",
    "Elara": "An irregular moon named for a mortal woman who bore Zeus's giant son, Tityus",
    "Carpo": "A small prograde irregular moon named after a Horae goddess of fruit",
    "Valetudo": "A prograde irregular moon, named for a Roman goddess of health, on an orbit that crosses paths with retrograde moons",
    "Ananke": "Lends its name to a group of retrograde irregular moons named for a Titaness of necessity",
    "Carme": "The largest member of its retrograde irregular moon group, discovered in 1938, holding about 99 percent of that group's total mass",
    "Pasiphae": "Lends its name to a group of irregular moons and shares her name with the mythical mother of the Minotaur",
    "Sinope": "Discovered in 1914, it was the most distant known moon of Jupiter until the discovery of Megaclite in 2000",
    "Callirrhoe": "One of the first irregular moons found by automated sky surveys, discovered in 1999"
  },
